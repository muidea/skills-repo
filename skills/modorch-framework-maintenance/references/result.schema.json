{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modorch Skill Result 1.0.0",
  "type": "object",
  "required": [
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "result": {
      "type": "object",
      "required": [
        "task",
        "framework_version",
        "skill",
        "skill_revision",
        "changed_files",
        "validation",
        "contract_checks",
        "limitations",
        "unresolved",
        "overall_status"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "framework_version": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "enum": [
            "modorch-app-development",
            "modorch-module-development",
            "modorch-framework-maintenance"
          ]
        },
        "skill_revision": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "status",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "Passed",
                  "Failed",
                  "NotRun"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "contract_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "status",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "Passed",
                  "Failed",
                  "NotRun"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "Passed",
            "Failed",
            "Blocked",
            "Partial"
          ]
        }
      }
    }
  }
}
